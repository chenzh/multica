# Copy to local.env (gitignored): cp local.env.example local.env
# 飞书 Bot 私聊: cp feishu-bot-notify.env.example feishu-bot-notify.env

# ── 非敏感 ───────────────────────────────────────────────
export GITHUB_ORG=your-github-org
export MUSIC_SAAS_PATH=/Users/you/Desktop/MusicSaas
# export AI_REPO_PATH_landing_tool_a=$HOME/Projects/landing-tool-a
# export AI_REPO_PATH_saas_stripe_mvp=$HOME/Projects/saas-stripe-mvp
# export AI_REPO_PATH_beatscape=/Users/you/path/to/MusicSaas
# export AI_COMPANY_REPO_SEARCH=$HOME/Projects:$HOME/Desktop

# ── 夜间 CEO 脱手（1=开）────────────────────────────────
export CEO_NIGHTLY_DISPATCH=1
export CEO_AUTO_MERGE=1
export CEO_SYNC_BACKLOG=1
export CEO_FEISHU_APPROVAL_PUSH=1

# ── Multica / 审批卡链接 ─────────────────────────────────
export MULTICA_FRONTEND_URL=http://localhost:3000
# export MULTICA_DEV_AGENT_ID=YOUR_MULTICA_AGENT_UUID

# ── 飞书事件订阅 Verification Token（飞书开放平台）────────
export FEISHU_VERIFICATION_TOKEN=YOUR_FEISHU_VERIFICATION_TOKEN

# ── Cloudflare Tunnel run token（Zero Trust → Tunnels → copy token）──
export CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN
# bash scripts/ai-company/ceo-feishu-cloudflare-tunnel.sh token-install

# ── GitHub PAT（repo + workflow）────────────────────────────
export PORTFOLIO_GH_TOKEN=github_pat_YOUR_GITHUB_TOKEN
# bash scripts/ai-company/setup-portfolio-github-token.sh

# ── 可选：群 webhook（与 feishu-bot-notify.env 二选一即可）─
# export FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_HOOK
# export SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# export CEO_BRIEF_DIR=$HOME/.multica/ceo-briefs

# ── 可选：GHA 派单（本机 --local 派单可不要）──────────────
# export CURSOR_API_KEY=crsr_YOUR_CURSOR_API_KEY

# 代理: cp proxy.env.example proxy.env
