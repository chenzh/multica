# Local overrides for AI company scripts (copy to local.env and: source .ai-company/config/local.env)

export GITHUB_ORG=chenzh

# Primary music product (BeatScape) — legacy alias still supported
export MUSIC_SAAS_PATH=/Users/you/Desktop/MusicSaas

# Generic per-project overrides (preferred)
# export AI_REPO_PATH_beatscape=/Users/you/path/to/MusicSaas
# export AI_REPO_PATH_chenzh_MusicSaas=/Users/you/path/to/MusicSaas

# Optional auto-discovery roots (colon-separated)
# export AI_COMPANY_REPO_SEARCH=$HOME/Projects:$HOME/Desktop:$HOME

# Optional: multica autopilot
# export MULTICA_DEV_AGENT_ID=
